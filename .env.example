# AWS Configuration (Required)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Download Configuration (Optional)
# Path where files will be downloaded (default: ~/Downloads/s3-bucket)
DOWNLOAD_PATH=

# Path where the ZIP file will be saved (default: ~/Downloads/s3-bucket.zip)
ZIP_FILE_PATH=

# Concurrency control
# Number of concurrent downloads (default: 10)
CONCURRENCY_LIMIT=

# Retry configuration
# Max retry attempts per file (default: 3)
MAX_RETRIES=

# Base delay for retry backoff in ms (default: 1,000)
# Delay doubles with each retry attempt
RETRY_DELAY_MS=

# Logging level (default: info)
LOG_LEVEL=
